# Copiare in .env. Il segreto NON ha un valore di scorta: senza, non parte.
# Generarlo con:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
CLEANVID_SEGRETO=
CLEANVID_AMBIENTE=sviluppo
CLEANVID_BASE_URL=http://localhost:8000
CLEANVID_DATABASE_URL=postgresql+asyncpg://cleanvid:cleanvid@localhost/cleanvid
CLEANVID_REDIS_URL=redis://localhost:6379/0

# Da riempire PRIMA di pubblicare: compaiono nella pagina «cos'è» e servono a
# chi deve scrivere per una segnalazione. Vuoti, quella parte della pagina non
# compare - che in locale va bene, online no.
CLEANVID_CONTATTO=
CLEANVID_GESTORE=

# Serve solo a strumenti/traduci.py, mai al servizio in esecuzione:
# le traduzioni si generano prima e si committano.
ANTHROPIC_API_KEY=
